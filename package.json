{
  "name": "satisfactory-start-optimizer-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev.js",
    "ui": "vp dev",
    "server": "vp run server:raw",
    "server:raw": "cargo run -- --server 8080",
    "server:release": "cargo run --release -- --server 8080",
    "build": "vp build",
    "check": "bun run check:js && bun run check:rust",
    "check:js": "vp check",
    "check:rust": "cargo fmt --check && bun run lint:rust",
    "lint": "vp lint && bun run lint:rust",
    "lint:rust": "cargo clippy --all-targets --locked -- -D warnings",
    "format": "vp fmt && bun run format:rust",
    "format:rust": "cargo fmt",
    "test": "bun run test:js && bun run test:rust",
    "test:js": "vp test run",
    "test:rust": "cargo nextest run --locked",
    "bench": "cargo bench --bench optimizer",
    "pack": "vp pack src/app.js --from-vite --out-dir dist/pack",
    "preview": "vp preview",
    "run": "vp run",
    "prepare": "vp config"
  },
  "devDependencies": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
    "vite-plus": "1.1.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.2",
      "onFail": "download"
    }
  }
}
